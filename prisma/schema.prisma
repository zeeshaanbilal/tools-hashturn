generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  emailVerified DateTime?
  image        String?
  passwordHash String?
  isTrialActive Boolean  @default(false)
  trialStartDate DateTime?
  trialEndDate   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans    UserPlan[]
  usage    ToolUsage[]
  accounts Account[]
  sessions Session[]
  processedFiles ProcessedFile[]
  apiCall ApiCall[]
}


model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id           String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@index([identifier, token])
}

model Plan {
  id                      String   @id @default(uuid())
  name                    String
  price                   Float    @default(0)
  durationDays            Int?
  maxToolsUsagePerMonth   Int?     // null = unlimited
  maxApiCallsPerMonth     Int?     // NEW
  maxFileSizeMB           Int?     // NEW
  isFree                  Boolean  @default(false)

  userPlans   UserPlan[]
}


model UserPlan {
  id               String   @id @default(uuid())
  userId           String
  planId           String

  subscriptionId   String?  @unique
  orderId          String?  @unique
  status           String   @default("pending") // pending | active | cancelled | expired

  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, isActive])
}

model WebhookEvent {
  id            String   @id @default(uuid())
  eventId       String   @unique // Lemon Squeezy event ID
  eventName     String
  subscriptionId String?
  processedAt   DateTime @default(now())

  @@index([eventId])
  @@index([subscriptionId])
}


model ToolCategory {
  id          String   @id @default(uuid())
  name        String
  description String?

  tools Tool[]
}

model Tool {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String
  type        String
  isActive    Boolean  @default(true)
  categoryId  String

  category   ToolCategory @relation(fields: [categoryId], references: [id])
  usage      ToolUsage[]
  processedFiles ProcessedFile[]
}

model ToolUsage {
  id      String   @id @default(uuid())
  userId  String
  toolId  String
  usedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  tool Tool @relation(fields: [toolId], references: [id])
}

model ProcessedFile {
  id          String   @id @default(uuid())
  userId      String
  toolId      String?
  fileName    String
  fileSize    Int
  fileType    String
  storagePath String?
  fileData    Bytes?
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  tool Tool? @relation(fields: [toolId], references: [id])
}
model ApiCall {
  id        String   @id @default(uuid())
  userId    String
  calledAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
